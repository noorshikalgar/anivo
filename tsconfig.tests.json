{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/test/**/*.ts",
    "tests/e2e/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts"
  ]
}
