{
  "name": "anivo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/spike/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "render:template": "tsx scripts/render-template.ts",
    "build:icons": "tsx scripts/build-icon-packs.ts",
    "dev": "pnpm --filter @anivo/web dev",
    "build:templates": "tsx scripts/build-templates.ts",
    "bench": "tsx scripts/bench.ts",
    "anivo": "node packages/cli/bin/anivo.js",
    "build:cli": "tsx scripts/build-cli.ts",
    "eval": "tsx evals/run.ts"
  },
  "devDependencies": {
    "@anivo/export-node": "workspace:*",
    "@anivo/fileio": "workspace:*",
    "@anivo/ops": "workspace:*",
    "@anivo/schema": "workspace:*",
    "@anthropic-ai/sdk": "0.135.0",
    "@eslint/js": "10.0.1",
    "@fluentui/svg-icons": "1.1.344",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "1.0.11",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "lucide-static": "1.59.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
