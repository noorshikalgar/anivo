{
  "name": "Anivo",
  "short_name": "Anivo",
  "description": "Draw a diagram, divide it into steps, and export an explainer video.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0F1B2D",
  "theme_color": "#1F2328",
  "categories": ["productivity", "graphics", "education"],
  "icons": [
    { "src": "app/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "app/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "app/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-anivo": [".anivo"] }, "icons": [{ "src": "app/icon-192.png", "sizes": "192x192", "type": "image/png" }], "launch_type": "single-client" }
  ],
  "shortcuts": [{ "name": "New scene", "url": "./?new=1", "icons": [{ "src": "app/icon-192.png", "sizes": "192x192" }] }]
}
