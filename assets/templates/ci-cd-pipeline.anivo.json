  "steps": [
    {
      "actions": [
        {
          "durationMs": 1300,
          "easing": "linear",
          "effect": "cascade",
          "id": "a1",
          "params": {
            "unit": "word"
          },
          "targets": [
            "title"
          ],
          "type": "enter"
        }
      ],
      "holdMs": 600,
      "id": "s-title",
      "title": "Title"
    },
    {
      "actions": [
        {
          "durationMs": 300,
          "effect": "fade",
          "id": "a2",
          "targets": [
            "title"
          ],
          "type": "exit"
        },
        {
          "effect": "rise",
          "id": "chain-19-1",
          "staggerMs": 150,
          "targets": [
            "commit",
            "build",
            "test",
            "deploy"
          ],
          "type": "enter"
        },
        {
          "after": "chain-19-1",
          "effect": "draw-on",
          "id": "a4",
          "staggerMs": 150,
          "targets": [
            "c-commit-build",
            "c-build-test",
            "c-test-deploy"
          ],
          "type": "enter"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "You push a commit. The pipeline starts on its own."
      },
      "id": "s-push-a-commit",
      "title": "Push a commit",
      "transition": {
        "durationMs": 600,
        "kind": "blur"
      }
    },
    {
      "actions": [
        {
          "flow": {
            "count": 1,
            "icon": "lucide:git-commit-horizontal",
            "shape": "icon",
            "size": 40
          },
          "id": "chain-23-0",
          "targets": [
            "c-commit-build"
          ],
          "type": "flow"
        },
        {
          "after": "chain-23-0",
          "effect": "pulse",
          "id": "chain-23-1",
          "targets": [
            "build"
          ],
          "type": "emphasis"
        },
        {
          "after": "chain-23-1",
          "id": "a7",
          "targets": [
            "build"
          ],
          "to": {
            "fill": "success-soft",
            "stroke": "success"
          },
          "type": "morph"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "The build server compiles the code and makes an image."
      },
      "id": "s-build",
      "title": "Build"
    },
    {
      "actions": [
        {
          "flow": {
            "count": 1,
            "icon": "lucide:package",
            "shape": "icon",
            "size": 40
          },
          "id": "chain-27-0",
          "targets": [
            "c-build-test"
          ],
          "type": "flow"
        },
        {
          "after": "chain-27-0",
          "effect": "fade",
          "id": "chain-27-1",
          "targets": [
            "tests"
          ],
          "type": "enter"
        },
        {
          "after": "chain-27-1",
          "counter": {
            "format": "{n} tests passed",
            "from": 0,
            "roll": true,
            "style": "thousands",
            "to": 1280
          },
          "durationMs": 2000,
          "id": "chain-27-2",
          "targets": [
            "tests"
          ],
          "type": "counter"
        },
        {
          "after": "chain-27-2",
          "id": "a11",
          "targets": [
            "test"
          ],
          "to": {
            "fill": "success-soft",
            "stroke": "success"
          },
          "type": "morph"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "Every test runs. One failure stops the pipeline."
      },
      "id": "s-test",
      "title": "Test"
    },
    {
      "actions": [
        {
          "flow": {
            "count": 1,
            "icon": "lucide:package",
            "shape": "icon",
            "size": 40
          },
          "id": "chain-32-0",
          "targets": [
            "c-test-deploy"
          ],
          "type": "flow"
        },
        {
          "after": "chain-32-0",
          "id": "chain-32-1",
          "targets": [
            "deploy"
          ],
          "to": {
            "fill": "success-soft",
            "stroke": "success"
          },
          "type": "morph"
        },
        {
          "after": "chain-32-1",
          "effect": "pop",
          "id": "chain-32-2",
          "targets": [
            "prod"
          ],
          "type": "enter"
        },
        {
          "after": "chain-32-2",
          "effect": "draw-on",
          "id": "chain-32-3",
          "targets": [
            "c-deploy-prod"
          ],
          "type": "enter"
        },
        {
          "after": "chain-32-3",
          "effect": "float",
          "id": "a16",
          "targets": [
            "prod"
          ],
          "type": "emphasis"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "The image goes to production, a few servers at a time."
      },
      "id": "s-deploy",
      "title": "Deploy"
    }
  ]
