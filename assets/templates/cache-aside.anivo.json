  "steps": [
    {
      "actions": [
        {
          "durationMs": 1300,
          "easing": "linear",
          "effect": "cascade",
          "id": "a1",
          "params": {
            "unit": "word"
          },
          "targets": [
            "title"
          ],
          "type": "enter"
        }
      ],
      "holdMs": 600,
      "id": "s-title",
      "title": "Title"
    },
    {
      "actions": [
        {
          "durationMs": 300,
          "effect": "fade",
          "id": "a2",
          "targets": [
            "title"
          ],
          "type": "exit"
        },
        {
          "effect": "rise",
          "id": "chain-14-1",
          "staggerMs": 200,
          "targets": [
            "app",
            "cache"
          ],
          "type": "enter"
        },
        {
          "after": "chain-14-1",
          "effect": "draw-on",
          "id": "chain-14-2",
          "targets": [
            "get"
          ],
          "type": "enter"
        },
        {
          "after": "chain-14-2",
          "flow": {
            "count": 1,
            "icon": "lucide:key",
            "shape": "icon",
            "size": 40
          },
          "id": "chain-14-3",
          "targets": [
            "get"
          ],
          "type": "flow"
        },
        {
          "after": "chain-14-3",
          "effect": "shake",
          "id": "a6",
          "targets": [
            "cache"
          ],
          "type": "emphasis"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "The app looks in the cache first. The key is not there."
      },
      "id": "s-cache-miss",
      "title": "Cache miss",
      "transition": {
        "durationMs": 600,
        "kind": "blur"
      }
    },
    {
      "actions": [
        {
          "effect": "rise",
          "id": "chain-20-0",
          "targets": [
            "db"
          ],
          "type": "enter"
        },
        {
          "after": "chain-20-0",
          "effect": "draw-on",
          "id": "chain-20-1",
          "targets": [
            "select"
          ],
          "type": "enter"
        },
        {
          "after": "chain-20-1",
          "effect": "fade",
          "id": "chain-20-2",
          "targets": [
            "latency"
          ],
          "type": "enter"
        },
        {
          "after": "chain-20-2",
          "flow": {
            "count": 1,
            "icon": "lucide:search",
            "shape": "icon",
            "size": 40
          },
          "id": "q",
          "targets": [
            "select"
          ],
          "type": "flow"
        },
        {
          "after": "q",
          "counter": {
            "format": "{n} ms",
            "from": 0,
            "roll": true,
            "to": 120
          },
          "durationMs": 1600,
          "id": "a11",
          "targets": [
            "latency"
          ],
          "type": "counter"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "On a miss, the app reads from the database: slow."
      },
      "id": "s-read-from-the-database",
      "title": "Read from the database"
    },
    {
      "actions": [
        {
          "flow": {
            "count": 1,
            "icon": "lucide:file-check",
            "shape": "icon",
            "size": 40
          },
          "id": "chain-26-0",
          "targets": [
            "get"
          ],
          "type": "flow"
        },
        {
          "after": "chain-26-0",
          "id": "a13",
          "targets": [
            "cache"
          ],
          "to": {
            "fill": "success-soft",
            "stroke": "success"
          },
          "type": "morph"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "The app writes the result to the cache for next time."
      },
      "id": "s-fill-the-cache",
      "title": "Fill the cache"
    },
    {
      "actions": [
        {
          "flow": {
            "count": 1,
            "icon": "lucide:key",
            "shape": "icon",
            "size": 40
          },
          "id": "chain-29-0",
          "targets": [
            "get"
          ],
          "type": "flow"
        },
        {
          "after": "chain-29-0",
          "effect": "spotlight",
          "id": "chain-29-1",
          "targets": [
            "cache"
          ],
          "type": "emphasis"
        },
        {
          "after": "chain-29-1",
          "counter": {
            "format": "{n} ms",
            "from": 120,
            "to": 2
          },
          "durationMs": 1200,
          "id": "a16",
          "targets": [
            "latency"
          ],
          "type": "counter"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "Next time: a cache hit, about sixty times faster."
      },
      "id": "s-cache-hit",
      "title": "Cache hit"
    }
  ]
}
