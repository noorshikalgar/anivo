            "c-lb-pod-2",
            "c-lb-pod-3"
          ],
          "type": "enter"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "Behind it, the same app runs in many pods."
      },
      "id": "s-pods-fan-out",
      "title": "Pods fan out"
    },
    {
      "actions": [
        {
          "id": "a6",
          "targets": [
            "c-user-lb"
          ],
          "type": "flow"
        },
        {
          "delayMs": 300,
          "flow": {
            "distribute": "round-robin"
          },
          "id": "a7",
          "targets": [
            "c-lb-pod-1",
            "c-lb-pod-2",
            "c-lb-pod-3"
          ],
          "type": "flow"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "It sends each request to the next pod in turn."
      },
      "id": "s-traffic-flows",
      "title": "Traffic flows"
    },
    {
      "actions": [
        {
          "id": "chain-23-0",
          "targets": [
            "pod-3"
          ],
          "to": {
            "fill": "danger-soft",
            "label": "pod-3 crashed",
            "stroke": "danger"
          },
          "type": "morph"
        },
        {
          "after": "chain-23-0",
          "effect": "circle",
          "id": "a9",
          "params": {
            "color": "danger"
          },
          "targets": [
            "pod-3"
          ],
          "type": "emphasis"
        },
        {
          "id": "a10",
          "targets": [
            "c-user-lb"
          ],
          "type": "flow"
        },
        {
          "flow": {
            "distribute": "round-robin",
            "skip": [
              "c-lb-pod-3"
            ]
          },
          "id": "a11",
          "targets": [
            "c-lb-pod-1",
            "c-lb-pod-2",
            "c-lb-pod-3"
          ],
          "type": "flow"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "A pod crashes. The load balancer stops sending to it."
      },
      "id": "s-pod-3-crashes",
      "title": "Pod 3 crashes"
    },
    {
      "actions": [
        {
          "id": "chain-28-0",
          "targets": [
            "pod-3"
          ],
          "to": {
            "fill": "success-soft",
            "label": "pod-3 (new)",
            "stroke": "success"
          },
          "type": "morph"
        },
        {
          "after": "chain-28-0",
          "flow": {
            "distribute": "round-robin"
          },
          "id": "a13",
          "targets": [
            "c-lb-pod-1",
            "c-lb-pod-2",
            "c-lb-pod-3"
          ],
          "type": "flow"
        }
      ],
      "caption": {
        "side": "auto",
        "text": "Kubernetes starts a new pod, and traffic goes there again."
      },
